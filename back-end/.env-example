# Copy to .env and adjust. The backend refuses to start without JWT_KEY.
SERVER_PORT=3000

# Use "db" when running through docker-compose, "localhost" when running npm run dev.
DB_HOST=db
DB_NAME=psru_booking
DB_USER=root
DB_PASSWORD=password01admin
DB_PORT=3306

# Generate a real one, e.g. `openssl rand -hex 32`. Never ship the sample value.
JWT_KEY=change-me-to-a-long-random-secret

# Comma-separated list of allowed browser origins.
# Leave empty when the frontend is served from the same origin through nginx.
WEB_ORIGIN=http://localhost

# Where uploaded room images are written. Must match the docker-compose volume mount.
UPLOAD_DIR=/app/uploads

# Timezone used for "today" in past-date and advance-booking checks.
# docker-compose sets this on both the backend and db services; they must agree.
TZ=Asia/Bangkok

# Email notifications (new request -> admins, admin approved -> approvers,
# final approval or rejection -> the booker). Leave SMTP_HOST empty to turn them off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the site, used for the link at the bottom of each email.
APP_URL=http://localhost
